# Supabase project settings — Project Settings > API in het Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Alleen server-side gebruikt (uitnodigingen versturen, admin-taken).
# NOOIT met NEXT_PUBLIC_ prefixen en nooit naar de client sturen.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Basis-URL van de app, gebruikt in uitnodigingsmails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
