# Supabase project settings — Project Settings > API in het Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Alleen server-side gebruikt (uitnodigingen versturen, admin-taken).
# NOOIT met NEXT_PUBLIC_ prefixen en nooit naar de client sturen.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Basis-URL van de app, gebruikt in uitnodigingsmails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optioneel: pushmeldingen. Genereer met `npx web-push generate-vapid-keys`.
# Zonder deze twee blijft push uitgeschakeld, de rest van de app werkt door.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optioneel maar aanbevolen: beveiligt /api/cron/deadline-reminders (de
# dagelijkse deadline-herinnering) tegen aanroepen door anderen dan
# Vercel Cron zelf. Verzin een lange willekeurige waarde en zet 'm ook
# als env var in Vercel — Vercel Cron stuurt 'm dan automatisch mee.
CRON_SECRET=
