<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>{{ shop.name }}</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;1,6..96,400&family=Jost:wght@300;400;500&display=swap">
    <style>
      :root {
        --bg: {{ settings.color_background }};
        --surface: {{ settings.color_surface }};
        --ink: {{ settings.color_text }};
        --muted: {{ settings.color_muted }};
        --line: {{ settings.color_line }};
        --bronze: {{ settings.color_accent }};
        --stage: {{ settings.color_stage }};
      }
    </style>
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-password">
    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
