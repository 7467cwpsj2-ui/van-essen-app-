<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_background }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; pagina {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;1,6..96,400&family=Jost:wght@300;400;500&display=swap">

    <style>
      :root {
        --bg: {{ settings.color_background }};
        --surface: {{ settings.color_surface }};
        --ink: {{ settings.color_text }};
        --muted: {{ settings.color_muted }};
        --line: {{ settings.color_line }};
        --bronze: {{ settings.color_accent }};
        --stage: {{ settings.color_stage }};
      }
    </style>
    {{ 'theme.css' | asset_url | stylesheet_tag }}

    <script>
      window.theme = {
        moneyFormat: {{ shop.money_format | json }},
        freeShippingThreshold: {{ settings.free_shipping_threshold | default: 0 | times: 100 | json }},
        routes: {
          cartAdd: {{ routes.cart_add_url | append: '.js' | json }},
          cart: {{ routes.cart_url | append: '.js' | json }},
          cartChange: {{ routes.cart_change_url | append: '.js' | json }},
          cartUrl: {{ routes.cart_url | json }}
        },
        strings: {
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }},
          emptyCart: {{ 'cart.empty' | t | json }},
          remove: {{ 'cart.remove' | t | json }},
          shippingLeft: {{ 'cart.shipping_left' | t | json }},
          shippingFree: {{ 'cart.shipping_free' | t | json }},
          error: {{ 'cart.error' | t | json }}
        }
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name }}">
    <a class="skip-link label" href="#MainContent">{{ 'general.skip_to_content' | t }}</a>

    {% section 'announcement-bar' %}
    {% section 'header' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    {% render 'cart-drawer' %}
    <div class="toast" id="Toast" hidden></div>
  </body>
</html>
