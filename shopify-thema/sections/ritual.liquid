<section class="band" id="ritueel">
  <div class="wrap">
    <div class="split">
      <div class="ph">{% render 'image', image: section.settings.image, fallback: 'rug-vrouw.jpg' %}</div>
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="label eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}{% if section.settings.heading_italic != blank %} <em>{{ section.settings.heading_italic }}</em>{% endif %}</h2>
        {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
      </div>
    </div>
    {%- if section.blocks.size > 0 -%}
      {%- assign romans = 'i,ii,iii,iv,v,vi' | split: ',' -%}
      <div class="steps">
        {%- for block in section.blocks -%}
          <div class="step" {{ block.shopify_attributes }}>
            <div class="ph">{% render 'image', image: block.settings.image, fallback: block.settings.fallback, sizes: '(min-width: 900px) 33vw, 100vw' %}</div>
            <span class="n">{{ romans[forloop.index0] }}.</span>
            <h3>{{ block.settings.heading }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Ritueel in stappen",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Afbeelding" },
    { "type": "text", "id": "eyebrow", "label": "Bovenschrift", "default": "Het ritueel" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Drie bewegingen," },
    { "type": "text", "id": "heading_italic", "label": "Kop, cursief deel", "default": "één gelijkmatige laag" },
    { "type": "richtext", "id": "text", "label": "Tekst", "default": "<p>De roller verdeelt de crème in een dunne, egale laag. Geen strepen, geen vette handen, en ook de plekken die je normaal mist.</p>" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Stap",
      "limit": 6,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Afbeelding" },
        { "type": "text", "id": "fallback", "label": "Voorbeeldfoto (bestandsnaam)", "info": "Wordt gebruikt zolang er geen afbeelding is gekozen." },
        { "type": "text", "id": "heading", "label": "Kop", "default": "Stap" },
        { "type": "textarea", "id": "text", "label": "Tekst" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ritueel in stappen",
      "blocks": [
        { "type": "step", "settings": { "heading": "Uitklappen", "fallback": "scharnier-marmer.jpg", "text": "Klik de steel uit tot hij vastzit. Ingeklapt past hij in elke tas." } },
        { "type": "step", "settings": { "heading": "Aanbrengen", "fallback": "roller-marmer.jpg", "text": "Doe een paar druppels zonnebrand of lotion op de roller." } },
        { "type": "step", "settings": { "heading": "Rollen", "fallback": "been-creme.jpg", "text": "Rol in lange halen van boven naar beneden. Spoel de roller daarna af." } }
      ]
    }
  ]
}
{% endschema %}
