<div class="wrap">
  <div class="page-head"><h1>{{ blog.title }}</h1></div>
  {%- paginate blog.articles by 9 -%}
    <div class="grid">
      {%- for article in blog.articles -%}
        <a class="card" href="{{ article.url }}">
          {%- if article.image -%}
            <div class="ph">{{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300, 500, 800', sizes: '(min-width: 900px) 33vw, 50vw' }}</div>
          {%- endif -%}
          <h3>{{ article.title }}</h3>
          <span class="p">{{ article.published_at | date: format: 'date' }}</span>
        </a>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <nav class="pagination label">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">{{ 'general.previous' | t }}</a>{%- endif -%}
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}">{{ 'general.next' | t }}</a>{%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{ "name": "Blog", "tag": "section", "settings": [] }
{% endschema %}
