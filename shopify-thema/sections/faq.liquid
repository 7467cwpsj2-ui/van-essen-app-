<section class="band" id="faq">
  <div class="wrap">
    {%- if section.settings.eyebrow != blank -%}<span class="label eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2>{{ section.settings.heading }}{% if section.settings.heading_italic != blank %} <em>{{ section.settings.heading_italic }}</em>{% endif %}</h2>
    <div class="faq">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <div class="content rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Veelgestelde vragen",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Bovenschrift", "default": "Service" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Veelgestelde" },
    { "type": "text", "id": "heading_italic", "label": "Kop, cursief deel", "default": "vragen" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Vraag",
      "settings": [
        { "type": "text", "id": "question", "label": "Vraag", "default": "Vraag" },
        { "type": "richtext", "id": "answer", "label": "Antwoord", "default": "<p>Antwoord</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Veelgestelde vragen",
      "blocks": [
        { "type": "question", "settings": { "question": "Hoe maak ik de roller schoon?", "answer": "<p>Spoel de roller na gebruik af met lauw water en hang de applicator aan het ophangoog te drogen.</p>" } },
        { "type": "question", "settings": { "question": "Werkt het ook met olie?", "answer": "<p>Het werkt het best met crème en lotion. Met olie gebruik je een kleine hoeveelheid, zodat er niets afdruipt.</p>" } },
        { "type": "question", "settings": { "question": "Mag hij mee in de handbagage?", "answer": "<p>Ja. Ingeklapt neemt hij weinig ruimte in en er zitten geen scherpe delen aan.</p>" } }
      ]
    }
  ]
}
{% endschema %}
