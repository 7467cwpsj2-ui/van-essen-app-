<div class="password-page">
  <div>
    <span class="logo">{{ shop.name }}</span>
    {%- if shop.password_message != blank -%}
      <p style="color:var(--muted);max-width:40ch;margin-inline:auto">{{ shop.password_message }}</p>
    {%- endif -%}
    {%- form 'storefront_password' -%}
      {{ form.errors | default_errors }}
      <label class="visually-hidden" for="Password">{{ 'general.password' | t }}</label>
      <input id="Password" type="password" name="password" placeholder="{{ 'general.password' | t }}" autocomplete="current-password">
      <button type="submit" class="btn btn-primary">{{ 'general.enter' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{ "name": "Wachtwoord", "tag": "section", "settings": [] }
{% endschema %}
