<section class="band manifest">
  <div class="wrap">
    {%- if section.settings.eyebrow != blank -%}<span class="label eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2>{{ section.settings.heading }}{% if section.settings.heading_italic != blank %} <em>{{ section.settings.heading_italic }}</em>{% endif %}</h2>
    {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.show_mosaic -%}
      <div class="mosaic">
        <div class="ph">{% render 'image', image: section.settings.image_1, fallback: 'rug-man.jpg', sizes: '(min-width: 900px) 40vw, 100vw' %}</div>
        <div class="ph">{% render 'image', image: section.settings.image_2, fallback: 'sfeer-marmer.jpg', sizes: '(min-width: 900px) 30vw, 50vw' %}</div>
        <div class="ph">{% render 'image', image: section.settings.image_3, fallback: 'roller-druppel.jpg', sizes: '(min-width: 900px) 30vw, 50vw' %}</div>
        <div class="ph">{% render 'image', image: section.settings.image_4, fallback: 'been.jpg', sizes: '(min-width: 900px) 30vw, 50vw' %}</div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Verhaal met mozaïek",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Bovenschrift", "default": "Waarom" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Verzorging tot op de" },
    { "type": "text", "id": "heading_italic", "label": "Kop, cursief deel", "default": "laatste centimeter" },
    { "type": "richtext", "id": "text", "label": "Tekst", "default": "<p>De plek tussen je schouderbladen is de plek die je het vaakst vergeet, en het eerst verbrandt. Wij maakten één doordacht gereedschap dat die plek binnen bereik brengt.</p>" },
    { "type": "checkbox", "id": "show_mosaic", "label": "Fotomozaïek tonen", "default": true },
    { "type": "image_picker", "id": "image_1", "label": "Foto 1 (groot)" },
    { "type": "image_picker", "id": "image_2", "label": "Foto 2 (hoog)" },
    { "type": "image_picker", "id": "image_3", "label": "Foto 3" },
    { "type": "image_picker", "id": "image_4", "label": "Foto 4" }
  ],
  "presets": [{ "name": "Verhaal met mozaïek" }]
}
{% endschema %}
