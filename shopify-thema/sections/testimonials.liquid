<section class="band" id="reviews">
  <div class="wrap">
    <div class="reviews-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="label eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.heading }}{% if section.settings.heading_italic != blank %} <em>{{ section.settings.heading_italic }}</em>{% endif %}</h2>
      </div>
      {%- if section.settings.note != blank -%}<div class="reviews-note">{{ section.settings.note }}</div>{%- endif -%}
    </div>
    <div class="reviews">
      {%- for block in section.blocks -%}
        <div class="review" {{ block.shopify_attributes }}>
          <span class="stars" aria-label="{{ block.settings.rating }} van 5 sterren">
            {%- for i in (1..5) -%}{% if i <= block.settings.rating %}★{% else %}☆{% endif %}{%- endfor -%}
          </span>
          <blockquote>“{{ block.settings.quote }}”</blockquote>
          <span class="who label">{{ block.settings.author }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ervaringen",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Bovenschrift", "default": "Ervaringen" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "In hun" },
    { "type": "text", "id": "heading_italic", "label": "Kop, cursief deel", "default": "eigen woorden" },
    { "type": "text", "id": "note", "label": "Notitie", "default": "Voorbeeldteksten, vervang door echte reviews", "info": "Maak leeg zodra je echte reviews gebruikt." }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "limit": 6,
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Citaat" },
        { "type": "text", "id": "author", "label": "Naam" },
        { "type": "range", "id": "rating", "label": "Sterren", "min": 1, "max": 5, "step": 1, "default": 5 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ervaringen",
      "blocks": [
        { "type": "review", "settings": { "quote": "Op vakantie hoef ik niemand meer te vragen. Klapt mooi klein in.", "author": "Voorbeeld · Onyx" } },
        { "type": "review", "settings": { "quote": "Mijn zelfbruiner zit eindelijk egaal op mijn rug.", "author": "Voorbeeld · Onyx" } },
        { "type": "review", "settings": { "quote": "Voor mijn vader, die zijn schouders slecht kan draaien. Hij smeert nu zelf.", "author": "Voorbeeld · Duo" } }
      ]
    }
  ]
}
{% endschema %}
