<div class="wrap">
  <div class="page-head">
    <span class="label" style="color:var(--bronze)">{{ 'collections.label' | t }}</span>
    <h1>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}<div class="rte">{{ collection.description }}</div>{%- endif -%}
  </div>

  {%- paginate collection.products by section.settings.per_page -%}
    {%- if collection.products.size > 0 -%}
      <div class="grid">
        {%- for product in collection.products -%}
          {% render 'product-card', card_product: product %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="empty">{{ 'collections.empty' | t }}</p>
    {%- endif -%}
    {%- if paginate.pages > 1 -%}
      <nav class="pagination label" aria-label="Paginering">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">{{ 'general.previous' | t }}</a>{%- endif -%}
        <span>{{ paginate.current_page }} / {{ paginate.pages }}</span>
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}">{{ 'general.next' | t }}</a>{%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Collectie",
  "tag": "section",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Producten per pagina", "min": 3, "max": 48, "step": 3, "default": 12 }
  ]
}
{% endschema %}
