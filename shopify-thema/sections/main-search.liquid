<div class="wrap">
  <div class="page-head">
    <h1>{{ 'general.search' | t }}</h1>
    <form class="search-form" action="{{ routes.search_url }}" method="get" role="search">
      <label class="visually-hidden" for="SearchInput">{{ 'general.search' | t }}</label>
      <input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search_placeholder' | t }}">
      <input type="hidden" name="type" value="product">
      <button type="submit" class="label">{{ 'general.search' | t }}</button>
    </form>
  </div>
  {%- if search.performed -%}
    {%- paginate search.results by 12 -%}
      {%- if search.results_count > 0 -%}
        <div class="grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', card_product: item %}
            {%- else -%}
              <a class="card" href="{{ item.url }}"><h3>{{ item.title }}</h3></a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <p class="empty">{{ 'general.no_results' | t: terms: search.terms }}</p>
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</div>

{% schema %}
{ "name": "Zoeken", "tag": "section", "settings": [] }
{% endschema %}
