<footer class="site">
  <div class="wrap">
    <div class="cols">
      <div>
        <h4 class="label">{{ section.settings.newsletter_heading }}</h4>
        {%- if section.settings.newsletter_text != blank -%}
          <div class="rte"><p>{{ section.settings.newsletter_text }}</p></div>
        {%- endif -%}
        {%- form 'customer', id: 'FooterNewsletter' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="news">
            <label class="visually-hidden" for="FooterEmail">{{ 'newsletter.email' | t }}</label>
            <input id="FooterEmail" type="email" name="contact[email]" placeholder="{{ 'newsletter.email' | t }}" autocomplete="email" required>
            <button type="submit" class="label">{{ 'newsletter.submit' | t }}</button>
          </div>
          {%- if form.posted_successfully? -%}
            <p class="news-msg">{{ 'newsletter.success' | t }}</p>
          {%- elsif form.errors -%}
            <p class="news-msg">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>
      {%- if section.settings.menu_1 != blank -%}
        <div>
          <h4 class="label">{{ section.settings.menu_1.title }}</h4>
          <ul>
            {%- for link in section.settings.menu_1.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
      {%- if section.settings.menu_2 != blank -%}
        <div>
          <h4 class="label">{{ section.settings.menu_2.title }}</h4>
          <ul>
            {%- for link in section.settings.menu_2.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_wordmark -%}
      <div class="bigmark" aria-hidden="true">{{ shop.name }}</div>
    {%- endif -%}

    <div class="legal label">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}{% if section.settings.legal_text != blank %} · {{ section.settings.legal_text }}{% endif %}</span>
      {%- if section.settings.show_payment_icons -%}
        <div class="pay">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Kop nieuwsbrief",
      "default": "Nieuwsbrief"
    },
    {
      "type": "text",
      "id": "newsletter_text",
      "label": "Tekst nieuwsbrief",
      "default": "Als eerste weten wanneer er nieuwe kleuren zijn. Geen spam, alleen wat de moeite waard is."
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Menu 1",
      "default": "footer"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Menu 2"
    },
    {
      "type": "checkbox",
      "id": "show_wordmark",
      "label": "Groot woordmerk tonen",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Betaalmethoden tonen",
      "default": true
    },
    {
      "type": "text",
      "id": "legal_text",
      "label": "Extra tekst onderaan",
      "default": "KvK 00000000"
    }
  ]
}
{% endschema %}
