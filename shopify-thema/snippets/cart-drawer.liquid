<div class="scrim" id="CartScrim" hidden></div>
<aside class="drawer" id="CartDrawer" aria-hidden="true" aria-label="{{ 'cart.title' | t }}" tabindex="-1">
  <div class="drawer-head">
    <h2>{{ 'cart.title' | t }}</h2>
    <button type="button" class="x label">{{ 'general.close' | t }}</button>
  </div>
  <div class="ship-bar" data-ship hidden>
    <span data-ship-text></span>
    <div class="meter"><i data-ship-meter></i></div>
  </div>
  <div class="lines" data-cart-lines>
    {%- if cart.item_count == 0 -%}
      <div class="empty">{{ 'cart.empty' | t }}</div>
    {%- endif -%}
  </div>
  <form class="totals" action="{{ routes.cart_url }}" method="post">
    <div class="row">
      <span class="label">{{ 'cart.subtotal' | t }}</span>
      <span data-cart-subtotal>{{ cart.total_price | money }}</span>
    </div>
    <small>{{ 'cart.taxes_note' | t }}</small>
    <button type="submit" name="checkout" class="btn btn-primary" data-checkout {% if cart.item_count == 0 %}disabled{% endif %}>
      {{ 'cart.checkout' | t }}
    </button>
    <a class="label link" href="{{ routes.cart_url }}" style="text-align:center">{{ 'cart.view_cart' | t }}</a>
  </form>
</aside>
